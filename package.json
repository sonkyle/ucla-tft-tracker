{
  "name": "ucla-tft-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Weekly LP + match history tracker for the UCLA TFT team",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "poll": "node src/poll.js",
    "build": "node src/build.js",
    "update": "node src/poll.js && node src/build.js",
    "serve": "node src/serve.js",
    "demo": "node src/demo.js && node src/serve.js --demo",
    "test": "node --test"
  }
}
